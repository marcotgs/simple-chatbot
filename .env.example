# Copy to .env (git-ignored) and fill in. Real env vars win over .env values.

# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Model calls trust the pinned certifi CA bundle, not the OS store. Behind a TLS-inspecting proxy
# set SSL_CERT_FILE (or SSL_CERT_DIR) to the proxy CA, or chat fails with a TLS error.
# SSL_CERT_FILE=

# Model on OpenRouter; must support tool calling and return usage.
# Default openai/gpt-4.1-mini: openai/gpt-4o-mini and google/gemini-2.5-flash return 404 "0 endpoints"
# on accounts with a zero-data-retention (ZDR) guardrail whenever tools are attached.
LLM_MODEL=openai/gpt-4.1-mini
# Optional model for judge/JSON calls only (fact extraction, forget resolver). Chat, summaries, doc
# notes and LinkedIn stay on LLM_MODEL. Unset = LLM_MODEL.
# Must support chat/completions + JSON output; decisions-only models (typesafe/jev-*) are incompatible.
# Example:
# JUDGE_MODEL=openai/gpt-4.1-mini
# Salience gate, ON by default: before each fact-extraction call, a decisions model scores
# "is anything here worth long-term memory?" (0..1); below GATE_THRESHOLD the extractor call is
# skipped. Unset = typesafe/jev-1.14. Set it empty (GATE_MODEL=) to turn the gate off. The model must
# support OpenRouter /api/alpha/decisions with noul questions; chat models are incompatible. Any gate
# error or timeout runs the extractor anyway (fail-open). Uses OPENROUTER_API_KEY.
# GATE_MODEL=typesafe/jev-1.14
# Probability below which the extractor is skipped. Default 0.3: the lowest worthy turn measured
# scored 0.56 (run-to-run noise up to 0.09), so do not go above 0.5. Lower = fewer skips, safer recall.
# GATE_THRESHOLD=0.3

# Hard limit per model call, checked against provider-reported usage.prompt_tokens.
MAX_INPUT_TOKENS=8000
# Context is trimmed to this estimate before each call (safety margin under MAX).
TARGET_INPUT_TOKENS=6500

# Secret key for forget tombstones (HMAC of forgotten values). Set a long random value and keep it;
# changing it makes earlier tombstones stop matching. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FORGET_SECRET=

# Paths are relative to the repo root.
DB_PATH=./data/chatbot.db
CALL_LOG_PATH=./logs/calls.jsonl

# Web server. If WEB_TOKEN is set, every request must send it as header
# X-Web-Token or query ?token= (open the page as /?token=...).
HOST=127.0.0.1
PORT=8000
WEB_TOKEN=
# Extra Host headers accepted, comma separated (e.g. chat.example.com). Loopback on PORT is always
# accepted; any other Host gets 403 (blocks DNS rebinding). POST /send needs Content-Type: application/json.
ALLOWED_HOSTS=

# Slack DM bot (Socket Mode, see SLACK_SETUP.md). Bot starts only when both tokens are set.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Your Slack member ID (U...). DMs from anyone else are politely refused.
SLACK_USER_ID=
# Largest file (bytes) the Slack bot downloads; 0 = unlimited. Needs the files:read scope.
MAX_FILE_BYTES=0

# summarize_doc: page-note calls run on this many threads (1 = one page after another).
# DOC_NOTE_WORKERS=4
# Completion token cap per page-note call.
# DOC_NOTE_MAX_TOKENS=1000
